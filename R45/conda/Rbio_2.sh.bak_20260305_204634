#!/bin/bash
# Stage 2: 预编译 R 包安装 (R 4.5.2 + Bioconductor 3.22)
#
# 策略说明（2026-03 更新）：
# - conda-forge 有大量 R 4.5 预编译包（r-openssl 2.3.5, r-curl, r-vctrs 等）
# - bioconda 有 bioconductor-* 系列包
# - 优先使用 conda 预编译包，避免源码编译失败
# - 少量 Bioconductor 包通过 BiocManager 安装
#
# 使用方法:
#   conda activate r45
#   ./Rbio_2.sh [--china]

set -e

# 引入公共库
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/Rbio_common.sh"

#========================================
# Stage 2: 预编译 R 包安装
#========================================
install_prebuilt_r_packages() {
    log_stage "[Stage 2] 安装 R 包"

    # Step 1: 优先安装 conda-forge R 预编译包（关键基础包）
    log_info "Installing R prebuilt packages from conda-forge..."
    mamba install -y -c conda-forge \
        r-openssl \
        r-curl \
        r-jsonlite \
        r-httr \
        r-xml2 \
        r-rcpp \
        r-vctrs \
        r-rlang \
        r-cachem \
        r-blob \
        r-memoise \
        r-rsqlite \
        r-matrix \
        r-survival \
        r-boot \
        r-nlme \
        r-mgcv \
        r-cluster \
        r-spatial \
        r-nnet \
        r-codetools \
        r-class \
        r-rpart \
        r-ggplot2 \
        r-gtable \
        r-scales \
        r-hts \
        r-forecast \
        r-quantmod \
        r-munsell \
        r-zoo \
        || log_warn "部分 conda-forge 包安装失败"

    # Step 2: 安装 bioconda Bioconductor 预编译包
    log_info "Installing Bioconductor packages from bioconda..."
    mamba install -y -c bioconda -c conda-forge \
        bioconductor-biostrings \
        bioconductor-genomicalignments \
        bioconductor-rsamtools \
        bioconductor-rtracklayer \
        bioconductor-genomicfeatures \
        bioconductor-bsgenome \
        || log_warn "部分 bioconda 包安装失败"

    # Step 3: 安装 BiocManager（R 版，用于安装额外 Bioconductor 包）
    log_info "Installing BiocManager..."
    mamba install -y -c conda-forge r-biocmanager

    # Step 4: 通过 BiocManager 安装额外包（如果 conda 没有预编译版本）
    log_info "Installing additional packages via BiocManager..."
    Rscript -e "
options(repos = c(CRAN = 'https://mirrors.tuna.tsinghua.edu.cn/CRAN/'));
options(BioC_mirror = 'https://mirrors.tuna.tsinghua.edu.cn/bioconductor/');
BiocManager::install(c('BiocGenerics', 'S4Vectors', 'IRanges', 'GenomicRanges', 
    'GenomeInfoDb', 'SummarizedExperiment', 'SingleCellExperiment'), 
    ask = FALSE, update = FALSE);
"

    # Step 5: 安装系统库依赖（处理 libgfortran 问题）
    log_info "Installing system library dependencies..."
    mamba install -y -c conda-forge \
        libgfortran \
        gcc_linux-64 \
        gxx_linux-64 \
        gfortran_linux-64 \
        libcurl \
        libxml2 \
        zlib \
        || log_warn "部分系统依赖安装失败"

    # 设置 LD_LIBRARY_PATH（解决运行时库问题）
    export LD_LIBRARY_PATH=${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}

    # Step 6: 验证关键包
    log_info "Verifying key packages..."
    Rscript -e "
options(repos = c(CRAN = 'https://mirrors.tuna.tsinghua.edu.cn/CRAN/'));
options(BioC_mirror = 'https://mirrors.tuna.tsinghua.edu.cn/bioconductor/');
library(Bioconductor);
library(Matrix);
library(survival);
cat('Stage 2 packages verified OK\n');
"

    log_stage_complete "Stage 2: R 包基础环境"
}

#========================================
# 主程序
#========================================
main() {
    if [[ "$1" == "--help" ]]; then
        echo "Stage 2: 预编译 R 包安装 (R 4.5.2 + Bioconductor 3.22)"
        echo ""
        echo "用法: $0 [--china] [--password PWD]"
        echo ""
        show_common_help
        exit 0
    fi

    rbio_init "$@"
    install_prebuilt_r_packages
    log_info "Stage 2 完成！可以继续执行 Stage 3"
}

main "$@"